FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=sola_attire_secret_key_2026

# ==============================================================================
# NCM (Nepal Can Move) Courier & Vendor API Credentials
# ==============================================================================
# Base URL: Use https://demo.nepalcanmove.com for Testing, or https://nepalcanmove.com for Production
NCM_API_BASE_URL=https://demo.nepalcanmove.com

# NCM Vendor API Key / Authorization Token
NCM_API_TOKEN=your_ncm_api_token_here

# NCM Vendor Dashboard Login Credentials
NCM_USER_EMAIL=your_ncm_email_here
NCM_USER_PASSWORD=your_ncm_password_here

# Origin / Pickup Branch Code registered with NCM (e.g. TINKUNE, KATHMANDU, POKHARA)
NCM_FROM_BRANCH=TINKUNE

# ==============================================================================
# Meta & WhatsApp Cloud API Credentials
# ==============================================================================
META_GRAPH_API_URL=https://graph.facebook.com/v19.0
META_ACCESS_TOKEN=your_meta_access_token
META_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WEBHOOK_VERIFY_TOKEN=sola_meta_verify_token_99
